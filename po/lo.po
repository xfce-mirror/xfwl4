#: resources/xfwl4.desktop.in:3
msgid "Xfce Session (Wayland)"
msgstr "ເຊດຊັນ Xfce (Wayland)"

#: resources/xfwl4.desktop.in:4
msgid "The Xfce Desktop Environment, Wayland Edition"
msgstr "ສະພາບແວດລ້ອມເດັສທັອບ Xfce, ຮຸ່ນ Wayland"

#: src/core/shell/mod.rs:704
msgid "Application Unresponsive"
msgstr "ແອັບພລິເຄຊັນບໍ່ຕອບສະໜອງ"

#: src/core/shell/mod.rs:706
msgid "Do you want to terminate the application?"
msgstr "ເຈົ້າຕ້ອງການຢຸດການເຮັດວຽກຂອງແອັບພລິເຄຊັນນີ້ບໍ່?"

#: src/core/shell/mod.rs:708
msgid "No"
msgstr "ບໍ່"

#: src/core/shell/mod.rs:710
msgid "Terminate"
msgstr "ຢຸດການເຮັດວຽກ"

#: src/ui/window_menu.rs:101
msgid "Ma_ximize"
msgstr "_ຂະຫຍາຍໃຫຍ່ສຸດ"

